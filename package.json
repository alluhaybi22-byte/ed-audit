{
  "name": "ed-audit",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs desktop-tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "desktop:start": "electron .",
    "desktop:pack": "npm run build && electron-builder --dir --publish never",
    "desktop:win": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "test:desktop": "playwright test -c desktop-tests/playwright.config.mjs",
    "checksums": "node scripts/checksums.mjs"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "pdfjs-dist": "6.4.299",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "description": "ED Audit — local emergency department data audit",
  "author": "ED Audit",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alluhaybi22-byte/ed-audit.git"
  }
}
